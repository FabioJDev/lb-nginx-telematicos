# Finales de línea LF para todo lo que entra en contenedores (un .sh con CRLF
# falla dentro del contenedor con errores crípticos del tipo "/bin/sh^M").
* text=auto eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.py text eol=lf
Makefile text eol=lf

# Binarios
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.pptx binary
