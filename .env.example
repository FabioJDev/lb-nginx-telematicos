# =============================================================================
# .env.example — copiar a .env (cp .env.example .env). El .env real NO se versiona.
# Los comentarios van en líneas propias (Compose no admite comentarios en línea).
# =============================================================================

# ---- Proyecto ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=lbnginx

# ---- Balanceador NGINX (R-17: workers, puerto público y política) ------------
# Versión estable fijada. Debe ser >= 1.28 para usar 'resolve' en upstream (OSS).
NGINX_IMAGE=nginx:1.30-alpine
# Puerto publicado en el host para el balanceador
LB_PUBLIC_PORT=8080
# Puerto (solo 127.0.0.1, solo con docker-compose.override.yml) para ver stub_status
LB_STATUS_PORT=8081
# worker_processes: auto = uno por CPU disponible
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=4096
# Política de balanceo: round_robin | least_conn | ip_hash | hash_client | hash_remote_addr | random_two
LB_POLICY=round_robin
# Función L7 extra: none | ratelimit | microcache  (A-01 / A-02)
LB_FEATURE=none
# keepalive hacia los backends: on | off  (E-12)
LB_UPSTREAM_KEEPALIVE=on

# ---- Detección pasiva de fallos y reintentos (R-10) --------------------------
LB_MAX_FAILS=3
LB_FAIL_TIMEOUT=10s
LB_CONNECT_TIMEOUT=2s
LB_SEND_TIMEOUT=10s
LB_READ_TIMEOUT=10s
# Condiciones que disparan el reintento en otro backend y cuentan como fallo para max_fails.
# SIN http_503: el 503 lo genera la aplicación cuando falla una dependencia (PostgreSQL, Redis);
# contarlo como caída del backend hacía que NGINX descartara réplicas sanas (hallazgo H-8, E-18B/E-19B).
LB_NEXT_UPSTREAM=error timeout http_502 http_504
LB_NEXT_UPSTREAM_TRIES=3
LB_NEXT_UPSTREAM_TIMEOUT=15s

# ---- Backends ---------------------------------------------------------------
BACKEND_REPLICAS=3
# Límites por réplica: hacen que los backends se saturen antes que el host (sección 8.2)
BACKEND_CPUS=0.50
BACKEND_MEMORY=256M
# Latencia artificial añadida a todas las peticiones (ms). 0 = backend "rápido"
BACKEND_BASE_DELAY_MS=0

# ---- Tienda web: base de datos y sesiones -----------------------------------
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
POSTGRES_DB=tienda
POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambiar-esto-db
POSTGRES_MAX_CONNECTIONS=200
# Límites de la base de datos (recurso COMPARTIDO por todas las réplicas)
DB_CPUS=1.0
DB_MEMORY=512M
# Conexiones del pool por réplica (N réplicas x DB_POOL_MAX <= POSTGRES_MAX_CONNECTIONS)
DB_POOL_MAX=10
# Dónde viven las sesiones: redis (compartidas) | memory (en cada réplica: requiere afinidad)
SESSION_STORE=redis

# ---- Backend heterogéneo (compose.weighted.yml, E-03) -----------------------
SLOW_BACKEND_DELAY_MS=150
SLOW_BACKEND_CPUS=0.25
LB_WEIGHT_FAST=1
LB_WEIGHT_SLOW=1

# ---- Artillery --------------------------------------------------------------
ARTILLERY_IMAGE=artilleryio/artillery:2.0.34
# Endpoint usado por rampa.yml / constante.yml (se puede sobrescribir con -e WORK_PATH=...)
WORK_PATH=/api/work?ms=20
# 1 = publicar métricas de Artillery en Prometheus vía Pushgateway (requiere profile monitoring)
PUBLISH_METRICS=0
# Segundos de calentamiento descartados por el análisis
WARMUP_SECONDS=30
# Artillery Cloud (opcional): clave de app.artillery.io para ver las corridas en su
# tablero web. Vacía = no se publica nada. Es un SECRETO: solo en .env (que no se
# versiona) o como secreto ARTILLERY_CLOUD_API_KEY del repositorio en GitHub.
ARTILLERY_CLOUD_API_KEY=
# on = publicar si hay clave · off = no publicar aunque haya clave
ARTILLERY_CLOUD=on

# ---- Observabilidad (profile monitoring, R-18) ------------------------------
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.5.3
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
PUSHGATEWAY_IMAGE=prom/pushgateway:v1.11.5
GRAFANA_IMAGE=grafana/grafana:12.4.15
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-esto

# ---- Comparativa HAProxy (compose.haproxy.yml, A-05) ------------------------
HAPROXY_IMAGE=haproxy:3.2-alpine
HAPROXY_PUBLIC_PORT=8090
HAPROXY_STATS_PORT=8404
# roundrobin | leastconn | source
HAPROXY_BALANCE=roundrobin

# ---- Herramientas (profile tools) ------------------------------------------
PYTHON_IMAGE=python:3.12-slim
# Navegador sin interfaz para las capturas de evidencia (compose.capturas.yml, make capturas)
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble
